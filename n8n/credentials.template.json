[
  {
    "id": "pulseopsWebhookAuth",
    "name": "PulseOps webhook header auth",
    "type": "httpHeaderAuth",
    "data": {"name": "X-PulseOps-Webhook-Key", "value": "${N8N_WEBHOOK_SECRET}"}
  },
  {
    "id": "pulseopsServiceAuth",
    "name": "PulseOps service_n8n",
    "type": "httpHeaderAuth",
    "data": {"name": "Authorization", "value": "Bearer ${PULSEOPS_N8N_TOKEN}"}
  }
]
